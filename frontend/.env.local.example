# The FastAPI backend. Must match where you run uvicorn.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Map tiles for "Near you". Defaults to OpenStreetMap's own tile server, which
# is free but meant for light use -- point this at a tile provider before
# heavy traffic. Must keep the {z}/{x}/{y} placeholders.
# NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
