# The FastAPI backend. Must match where you run uvicorn.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Map style for "Near you": any MapLibre style URL. Defaults to OpenFreeMap's
# "Liberty" -- current OpenStreetMap data, free, no key, no usage limits.
# NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
