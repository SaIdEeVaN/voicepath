# Kept alongside the root .gitignore so this directory stays safe if it is
# ever pushed on its own. Secrets must never be committed: the deployment
# reads them from the host's environment instead.
.env
.env.*
!.env.example

# Piper voice files, fetched at build time by app.scripts.fetch_voices.
# Leading slash matters: a bare `models/` also matches app/models/, which
# holds schemas.py -- excluding it makes the app unimportable at runtime.
/models/
.cache/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
*.egg-info/

*.log
