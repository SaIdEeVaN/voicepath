# VoicePath backend -- copy to .env and fill in.
#
# Every value here is optional. With none of them set the API still runs:
# providers drop to offline, storage drops to in-memory, and /health says so.

# --- Core ------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO

# Supabase Postgres. Prefer the POOLER host: db.PROJECT.supabase.co is
# IPv6-only, so on an IPv4-only network it fails to resolve at all and the
# API refuses to start. The pooler is reachable over IPv4.
# Note the username is postgres.PROJECT, not postgres.
# Percent-encode the password: a literal @ or : will break the URL.
# DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Comma-separated. The Next.js origin must be listed.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# --- Speech (local, open source) -------------------------------------------
# faster-whisper (MIT) and Piper (MIT). No key, no network, no per-call cost.
# STT_MODEL: tiny|base|small|medium|large-v3. Larger is slower, not always
# better -- large-v3 measured 1.6x slower here with no Tamil gain.

STT_PROVIDER=groq
STT_MODEL=medium
STT_GROQ_MODEL=whisper-large-v3

TTS_PROVIDER=local
PIPER_VOICE_DIR=models/piper
# Voices loaded at startup instead of on the first request that needs one.
# Each is a 63MB read -- measured at 2.7s -- and it otherwise lands between a
# person seeing an answer and hearing it, again after every idle sleep.
# Comma-separated; empty warms nothing. All three would hold ~190MB.
TTS_WARM_LANGUAGES=ta

# --- LLM -------------------------------------------------------------------
# groq | gemini | offline. Groq hosts open-weight models (Llama, Gemma,
# gpt-oss): the weights are open source, the hosting is not. This is the
# only component that needs a key. Free from https://console.groq.com/keys
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_MODEL=qwen/qwen3.8-27b
LLM_MAX_OUTPUT_TOKENS=4000
# Added on top of each call's answer budget, for models that think first.
LLM_REASONING_HEADROOM=0
LLM_TIMEOUT_SECONDS=120
# LLM_BASE_URL=

# --- Web search (PRD section 7) --------------------------------------------
# Finds official scheme pages the ingested documents do not cover. Without a
# key the corpus still answers what it holds; only the widening stops.
# Free key: https://app.tavily.com
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
# Only these domains are searched. Every page found is stored pending an
# admin decision on /admin/sources -- nothing fetched is answerable until then.
TRUSTED_DOMAINS=gov.in,nic.in,india.gov.in,myscheme.gov.in,ncs.gov.in,skillindiadigital.gov.in,eshram.gov.in,pmvishwakarma.gov.in
# Never searched or stored, whatever their suffix: news sites are .gov.in too.
EXCLUDED_DOMAINS=ddnews.gov.in,newsonair.gov.in,prasarbharati.gov.in
SEARCH_CACHE_HOURS=24

# --- Nearby places (the map) -----------------------------------------------
# Training centres, employment and government offices, and banks near a
# person, from OpenStreetMap. Around the towns the map knows they come from a
# bundled snapshot (python -m app.scripts.fetch_support_places refreshes it);
# elsewhere from the Overpass API, live. No key, no cost. offline turns the
# live lookups off; the snapshot still answers what it covers.
PLACES_PROVIDER=overpass
# Tried in order until one answers. Public instances are volunteer-run.
OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://maps.mail.ru/osm/tools/overpass/api/interpreter
PLACES_TIMEOUT_SECONDS=20
PLACES_CACHE_HOURS=24

# --- Embeddings ------------------------------------------------------------
# onnx    -- multilingual-e5-small inside the API (the default since
#            2026-11-10). No key, nothing to run out of. Needs
#            requirements-deploy.txt and the model files:
#            python -m app.scripts.fetch_embedding_model
# local   -- sentence-transformers in-process. Needs requirements-ml.txt.
# hf_api  -- the HF Inference API. Needs HF_TOKEN, and credits.
# offline -- deterministic hashing. Lexical reach only; NOT comparable
#            with vectors written by the others, and never written to the
#            database.
# A different model writes different vectors: changing it means resizing the
# pgvector columns and re-embedding (see db/015_small_embeddings.sql).
EMBEDDING_PROVIDER=onnx
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIMENSION=384
EMBEDDING_MODEL_DIR=models/e5-small

# --- Matching (PRD section 8) ---------------------------------------------
# The weights are set per kind -- job, training, scheme -- in
# backend/app/services/kinds.py, not here.

# Model-specific: re-measured for e5-small (see config.py).
NORMALIZATION_ACCEPT_THRESHOLD=0.84
NORMALIZATION_CANDIDATE_THRESHOLD=0.60
MATCH_RESULT_LIMIT=8

# --- Privacy (PRD section 7) ----------------------------------------------
# false makes evidence playback impossible regardless of what a request asks.
AUDIO_RETENTION_DAYS=90

# --- Rate limiting (PRD section 6.6) --------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_SPEECH_PER_MINUTE=12
RATE_LIMIT_ASSISTANT_PER_MINUTE=20
RATE_LIMIT_DEFAULT_PER_MINUTE=60
# Shared counters, so limits hold across instances. On Render: the Key Value
# instance's internal URL. Unset: counted per process.
RATE_LIMIT_REDIS_URL=

# --- Admin (Phase 2) -------------------------------------------------------
# Honoured only while admin_users is empty. Once a real admin row exists this
# value stops working, so it cannot become a permanent backdoor.
# ADMIN_BOOTSTRAP_TOKEN=
